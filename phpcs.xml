<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Yii2">
    <rule ref="vendor/yiisoft/yii2-coding-standards/Yii2"></rule>

    <!-- generate relative paths -->
    <arg name="basepath" value="."/>

    <!-- directories to check -->
    <file>config</file>
    <file>src</file>
    <file>tests</file>

    <!-- Codeception-generated actor classes -->
    <exclude-pattern>tests/Support/_generated/*</exclude-pattern>
</ruleset>
